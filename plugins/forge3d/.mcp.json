{
  "mcpServers": {
    "blender": {
      "command": "C:\\Users\\George\\.local\\bin\\uvx.exe",
      "args": [
        "--python",
        "3.11",
        "--from",
        "blender-mcp==1.6.5",
        "blender-mcp"
      ],
      "env": {
        "BLENDER_HOST": "127.0.0.1",
        "BLENDER_PORT": "9876",
        "DISABLE_TELEMETRY": "true"
      }
    },
    "godot": {
      "command": "C:\\Windows\\System32\\cmd.exe",
      "args": [
        "/c",
        "npx",
        "-y",
        "@npgamedev/godot-mcp-server@1.0.0"
      ],
      "cwd": "C:\\Users\\George\\Godot Projects\\Dev-Tools\\godot",
      "env": {
        "GODOT_MCP_CONFIG_VERSION": "1",
        "GODOT_MCP_PROJECT_PATH": "C:\\Users\\George\\Godot Projects\\Dev-Tools\\godot"
      }
    }
  }
}
