{
  "mcpServers": {
    "blender": {
      "command": "uvx",
      "args": ["--python", "3.11", "--from", "blender-mcp==1.6.5", "blender-mcp"],
      "env": {
        "BLENDER_HOST": "127.0.0.1",
        "BLENDER_PORT": "9876",
        "DISABLE_TELEMETRY": "true"
      }
    },
    "godot": {
      "command": "npx",
      "args": ["-y", "@npgamedev/godot-mcp-server@1.0.0"],
      "env": {
        "GODOT_MCP_CONFIG_VERSION": "1"
      }
    }
  }
}